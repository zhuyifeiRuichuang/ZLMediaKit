# ZLMediaKit 运行时镜像（最精简）
#
# 设计: 从「预编译制品」装配，而非在镜像内编译。
#  - 编译在 GitHub Actions 原生 amd64/arm64 runner 完成（见 building/build.sh）
#  - 本 Dockerfile 仅负责把对应架构的制品放入最小基础镜像
#  - 通过 --build-arg ARCH=amd64|arm64 选择制品目录；逐架构构建后由
#    `docker buildx imagetools create` 合并为多架构清单
#
# 基础镜像: ubuntu:24.04（glibc，与编译 runner 同发行版，保证 SONAME 一致）
#   说明: 编译在 ubuntu-24.04 runner 完成，二进制动态链接 ubuntu 的
#         libav*(FFMPEG) / libmysqlclient(MySQL) / libpython(Python)。
#         若改用 debian:13-slim 等其它发行版，这些库的 SONAME 版本不一致，
#         会导致容器启动报 "error while loading shared libraries"。
#         因此完整功能（含 FFMPEG/MYSQL/PYTHON）镜像必须使用 ubuntu:24.04。
#   体积: 接受更大镜像（用户已确认）。如需最小体积，请仅启用 API/WEBRTC/SRT/SCTP
#         等不依赖发行版多媒体库的组件，并改用 debian:13-slim。
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG ARCH
ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    PYTHONPATH=/opt/media/bin/python

# 运行时依赖（与编译期动态链接一一对应）:
#   ffmpeg           提供 libavcodec/libavformat/libavutil/libswscale/libswresample/libavfilter 运行时
#   libmysqlclient21  MySQL 客户端钩子运行时（libmysqlclient.so.21）
#   python3          内嵌 Python 解释器运行时
#   libpython3.12t64 libpython3.12.so.1.0 共享库本体（noble 中 python3 依赖链不自动拉取，deploy-test run 36543592100 实测缺失）
#   libssl3          OpenSSL 3 运行时（WebRTC/HTTPS/RTSPS）
#   libsrtp2-1       SRTP 运行时（WebRTC）
#   libusrsctp2      SCTP/datachannel 运行时（启用时）
#   libstdc++6/libgcc-s1/libatomic1  C++/atomics 运行时（arm64 常见）
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates tzdata \
      ffmpeg libmysqlclient21 python3 libpython3.12t64 \
      libssl3 libsrtp2-1 libusrsctp2 \
      libstdc++6 libgcc-s1 libatomic1 \
 && rm -rf /var/lib/apt/lists/* \
 && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
 && echo ${TZ} > /etc/timezone

WORKDIR /opt/media/bin

# 复制对应架构的制品（由 build 上下文中的 <ARCH>/ 目录提供）
COPY ${ARCH}/bin/MediaServer /opt/media/bin/MediaServer
COPY ${ARCH}/bin/default.pem /opt/media/bin/default.pem
COPY ${ARCH}/bin/www/        /opt/media/bin/www/
COPY ${ARCH}/conf/config.ini /opt/media/conf/config.ini

RUN chmod +x /opt/media/bin/MediaServer

# 标准端口（与 conf/config.ini 默认一致）:
#   RTMP 1935 / RTSP 554 / HTTP 80 / HTTPS 443
#   RTP_PROXY 10000 / RTC 8000 / 9000（TCP+UDP）
EXPOSE 1935/tcp 554/tcp 80/tcp 443/tcp 10000/tcp 8000/tcp 9000/tcp
EXPOSE 10000/udp 8000/udp 9000/udp

# 健康检查: 探测 HTTP(80) 端口是否就绪（bash 内置 /dev/tcp，无需额外工具）
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/80' || exit 1

# 工作目录即二进制所在目录，故相对路径 default.pem / ../conf/config.ini 生效
ENTRYPOINT ["./MediaServer", "-s", "default.pem", "-c", "../conf/config.ini", "-l", "0"]
